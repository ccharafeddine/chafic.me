---
import '../styles.css';
import { ClientRouter } from 'astro:transitions';
const { title='Chafic Charafeddine' } = Astro.props;
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content="Chafic Charafeddine: finance, valuation, and trading analytics. Interactive CV."/><ClientRouter/></head>
<body class="font-sans antialiased">
<div id="progress" class="fixed top-0 left-0 right-0 h-[3px] z-[60] origin-left scale-x-0 bg-gradient-to-r from-accent to-accent2"></div>
<div id="cursor-glow" class="pointer-events-none fixed top-0 left-0 w-[400px] h-[400px] rounded-full z-0 opacity-0" style="background:radial-gradient(circle,rgba(56,189,248,.12),transparent 65%)"></div>
<nav class="fixed top-0 inset-x-0 z-50 backdrop-blur bg-ink/70 border-b border-white/5"><div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
<a href="/" class="font-semibold tracking-tight">Chafic Charafeddine</a>
<div class="hidden sm:flex gap-6 text-sm text-gray-400"><a href="/#about">About</a><a href="/#experience">Experience</a><a href="/#projects">Projects</a><a href="/#education">Education</a><a href="/#skills">Skills</a><a href="/#contact">Contact</a></div></div></nav>
<main class="pt-14 relative z-10"><slot/></main>
<footer class="text-center text-xs text-gray-500 py-10">© {new Date().getFullYear()} Chafic Charafeddine</footer>
<script>import '../scripts/motion.ts';</script>
</body></html>
