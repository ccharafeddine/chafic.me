---
import Base from '../layouts/Base.astro';
import { timeline, categories } from '../data/timeline.js';
const color = { 'Education':'#38bdf8','Experience':'#34d399','Projects':'#a78bfa','Side projects':'#2dd4bf','Markets & mining':'#fbbf24','Activities & service':'#f472b6','Certifications':'#f97316' };
const years = [...new Set(timeline.map(e=>e.date.match(/\d{4}/)[0]))];
---
<Base title="Timeline · Chafic Charafeddine">
<section class="max-w-4xl mx-auto px-6 py-16">
<a href="/" class="text-sm text-gray-400 hover:text-accent">← Home</a>
<h1 class="split text-4xl sm:text-6xl font-bold mt-6">Timeline</h1>
<p class="text-gray-400 mt-4 max-w-2xl reveal">Education, work, projects and activities from 2013 to today. Filter by category, and click an entry for details.</p>
<div id="tl-filters" class="flex flex-wrap gap-2 mt-8 sticky top-14 z-20 py-3 bg-ink/85 backdrop-blur" role="group" aria-label="Filter timeline">
<button data-f="all" aria-pressed="true" class="tl-chip">All <span class="opacity-60">{timeline.length}</span></button>
{categories.map(c=>(<button data-f={c} aria-pressed="false" class="tl-chip"><span class="inline-block w-2 h-2 rounded-full mr-1.5" style={`background:${color[c]}`}></span>{c} <span class="opacity-60">{timeline.filter(e=>e.cat===c).length}</span></button>))}
<button id="tl-expand" class="tl-chip ml-auto">Expand all</button>
</div>
<ol id="tl" class="relative ml-3 mt-8"><span class="absolute left-0 top-0 bottom-0 w-px bg-white/10"></span><span id="tl-line" class="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-accent to-accent2 origin-top"></span>
{timeline.map((e,i)=>{ const y=e.date.match(/\d{4}/)[0]; const first=timeline.findIndex(x=>x.date.match(/\d{4}/)[0]===y)===i; return (
<li class="tl-item mb-6 ml-6 relative" data-cat={e.cat}>
{first && <p class="tl-year absolute -left-[4.5rem] top-0 text-xs font-mono text-gray-500 hidden md:block">{y}</p>}
<span class="absolute -left-[31px] top-5 tl-dot w-3.5 h-3.5 rounded-full ring-4 ring-ink" style={`background:${color[e.cat]}`}></span>
<details class="card group p-4 hover:border-white/20 transition-colors" open={false}>
<summary class="cursor-pointer list-none flex flex-wrap items-baseline gap-x-3 gap-y-1">
<span class="text-xs font-mono" style={`color:${color[e.cat]}`}>{e.date}</span>
<span class="text-[10px] uppercase tracking-wider text-gray-500">{e.cat}</span>
<span class="w-full font-semibold text-white">{e.title}</span>
<span class="w-full text-sm text-gray-400">{e.summary}</span>
{(e.more||e.link) && <span class="text-xs text-accent mt-1 group-open:hidden">Details +</span>}
</summary>
{(e.more||e.link) && <div class="tl-more mt-3 pt-3 border-t border-white/5 text-sm text-gray-300 space-y-2">
{e.more && <ul class="list-disc pl-5 space-y-1">{e.more.map(m=><li>{m}</li>)}</ul>}
{e.link && <a href={e.link[0]} class="inline-block text-accent hover:underline">{e.link[1]} →</a>}
</div>}
</details></li>)})}
</ol>
<p id="tl-empty" hidden class="text-gray-500 text-sm">No entries in this category yet.</p>
</section>
<style>
.tl-chip{font-size:.8rem;padding:.35rem .8rem;border-radius:9999px;border:1px solid rgba(255,255,255,.12);color:#9ca3af;transition:all .2s}
.tl-chip:hover{color:#fff;border-color:rgba(255,255,255,.3)}
.tl-chip[aria-pressed=true]{background:rgba(56,189,248,.15);border-color:#38bdf8;color:#fff}
details summary::-webkit-details-marker{display:none}
details[open]{border-color:rgba(56,189,248,.35)}
</style>
<script>
import { ScrollTrigger } from 'gsap/ScrollTrigger';
document.addEventListener('astro:page-load', () => {
  const bar = document.getElementById('tl-filters'); if (!bar) return;
  const items = [...document.querySelectorAll<HTMLElement>('.tl-item')];
  const chips = [...bar.querySelectorAll<HTMLButtonElement>('[data-f]')];
  chips.forEach(b => b.addEventListener('click', () => {
    const f = b.dataset.f!;
    chips.forEach(c => c.setAttribute('aria-pressed', String(c === b)));
    let n = 0; items.forEach(li => { const on = f === 'all' || li.dataset.cat === f; li.hidden = !on; if (on) { n++; li.style.opacity = '1'; li.style.transform = 'none'; } });
    document.getElementById('tl-empty')!.hidden = n > 0;
    // year labels only make sense in the unfiltered view
    document.querySelectorAll<HTMLElement>('.tl-year').forEach(y => y.style.visibility = f === 'all' ? '' : 'hidden');
    ScrollTrigger.refresh();
  }));
  const ex = document.getElementById('tl-expand')!; let open = false;
  ex.addEventListener('click', () => { open = !open; document.querySelectorAll('#tl details').forEach(d => (d as HTMLDetailsElement).open = open); ex.textContent = open ? 'Collapse all' : 'Expand all'; ScrollTrigger.refresh(); });
  document.querySelectorAll('#tl details').forEach(d => d.addEventListener('toggle', () => ScrollTrigger.refresh()));
});
</script>
</Base>
