---
import Base from '../../../layouts/Base.astro';
const sliders=[
 ['vol','Volatility of MtM (σ, % of notional / √yr)',5,40,1,20],
 ['tenor','Trade tenor (years)',1,30,1,10],
 ['thr','CSA threshold H (% of notional; 30 = no CSA)',0,30,0.5,30],
 ['haz','Counterparty hazard rate λ (% / yr)',0.1,10,0.1,2],
];
---
<Base title="Counterparty exposure & CVA demo · Chafic Charafeddine">
<section class="max-w-6xl mx-auto px-6 py-14">
<a href="/projects/derivatives-underwriting-workbench" class="text-sm text-gray-400 hover:text-accent">← Derivatives Underwriting Workbench</a>
<h1 class="text-4xl font-bold mt-4">Monte Carlo exposure & CVA</h1>
<p class="mt-3 text-gray-300 max-w-3xl">A browser version of the workbench's core idea. It simulates the mark-to-market of a swap-like trade, applies a CSA threshold, and computes Expected Exposure (EE), 95% Potential Future Exposure (PFE), and unilateral CVA.</p>
<p class="mt-3 inline-block text-xs px-3 py-1 rounded-full bg-amber-400/15 text-amber-300">Illustrative only · synthetic data · simplified model, not a pricing tool</p>
<div class="grid lg:grid-cols-[320px_1fr] gap-8 mt-10">
<div class="card p-6 space-y-6">
{sliders.map(([id,l,mn,mx,st,v])=>(<label class="block"><div class="flex justify-between text-sm"><span class="text-gray-300">{l}</span><output id={`${id}-o`} class="text-accent font-mono">{v}</output></div>
<input id={id} type="range" min={mn} max={mx} step={st} value={v} class="w-full accent-sky-400 mt-2"/></label>))}
<p class="text-xs text-gray-500">Notional 100 · 2,000 paths · LGD 60% · discount rate 3% · 5-day margin period of risk ignored for clarity.</p>
</div>
<div>
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
<div class="card p-4"><p class="text-xs text-gray-400">CVA <span class="text-gray-600">(% of notional)</span></p><p id="k-cva" class="kpi text-2xl font-bold text-accent font-mono">–</p><p id="d-cva" class="text-[11px] font-mono h-4"></p></div>
<div class="card p-4"><p class="text-xs text-gray-400">Peak EE</p><p id="k-ee" class="kpi text-2xl font-bold font-mono">–</p><p id="d-ee" class="text-[11px] font-mono h-4"></p></div>
<div class="card p-4"><p class="text-xs text-gray-400">Peak PFE 95%</p><p id="k-pfe" class="kpi text-2xl font-bold text-accent2 font-mono">–</p><p id="d-pfe" class="text-[11px] font-mono h-4"></p></div>
<div class="card p-4"><p class="text-xs text-gray-400">Default prob. over tenor</p><p id="k-pd" class="kpi text-2xl font-bold text-amber-300 font-mono">–</p><p id="d-pd" class="text-[11px] font-mono h-4"></p></div>
</div>
<div class="card p-4"><canvas id="chart" class="w-full" style="height:380px"></canvas>
<div class="flex gap-5 text-xs text-gray-400 mt-2 px-2"><span><b class="text-gray-500">━</b> sample MtM paths</span><span><b class="text-sky-400">━</b> EE</span><span><b class="text-violet-400">━</b> PFE 95%</span><span><b class="text-amber-300">┅</b> CSA threshold H</span><span><b class="text-rose-400">░</b> default-weighted EE (drives CVA)</span></div></div>
</div></div>
<div class="card p-6 mt-8 text-sm text-gray-400 leading-relaxed">
<h2 class="text-gray-200 font-semibold mb-2">Model</h2>
MtM(t) = σ·W(t)·(T−t)/T·N, a Brownian driver with linear amortization (the classic swap "hump"). Collateral posted C(t) = max(MtM(t) − H, 0), so exposure E(t) = min(max(MtM(t), 0), H). EE(t) = mean E(t); PFE(t) = 95th percentile of E(t).
CVA = LGD · Σ DF(tᵢ) · EE(tᵢ) · [e^(−λtᵢ₋₁) − e^(−λtᵢ)].
</div>
</section>
<style>.kpi{transition:color .3s}.kpi.flash{color:#fff!important}</style>
<script>
// Fixed axes (x: 0–30y, y: stepped "nice" scale) so every slider visibly changes the chart. The previous version
// auto-scaled both axes to the data, and because the random draws are fixed, changing volatility or tenor just
// rescaled the same picture. Hazard rate had no visual at all. Now: tweened redraws, threshold line, default-weighted EE.
const STEPS=60,P=2000,N=100,LGD=0.6,R=0.03,TMAX=30;
let s=42; const rnd=()=>{s=(s*1664525+1013904223)>>>0;return s/4294967296;};
const Z=new Float32Array(P*STEPS); for(let i=0;i<Z.length;i++) Z[i]=Math.sqrt(-2*Math.log(rnd()||1e-9))*Math.cos(2*Math.PI*rnd());
type Res={T:number,H:number,lam:number,samp:number[][],ee:number[],pfe:number[],cva:number,pd:number};
function sim(vol:number,T:number,H:number,lam:number):Res{
  const dt=T/STEPS,sq=Math.sqrt(dt),W=new Float32Array(P),col=new Float32Array(P),ee=[0],pfe=[0],samp:number[][]=Array.from({length:30},()=>[0]); let cva=0;
  for(let k=1;k<=STEPS;k++){const t=k*dt;
    for(let p=0;p<P;p++){W[p]+=Z[p*STEPS+k-1]*sq;const m=vol*W[p]*(T-t)/T*N;col[p]=Math.min(Math.max(m,0),H);if(p<30)samp[p].push(m);}
    let sum=0;for(let p=0;p<P;p++)sum+=col[p];const e=sum/P;ee.push(e);
    const so=Array.from(col).sort((a,b)=>a-b);pfe.push(so[Math.floor(0.95*P)]);
    cva+=LGD*Math.exp(-R*t)*e*(Math.exp(-lam*(t-dt))-Math.exp(-lam*t));}
  return {T,H,lam,samp,ee,pfe,cva,pd:1-Math.exp(-lam*T)};
}
let cleanup:(()=>void)|null=null;
document.addEventListener('astro:before-swap',()=>{cleanup?.();cleanup=null;});
document.addEventListener('astro:page-load',()=>{
  const cv=document.getElementById('chart') as HTMLCanvasElement|null; if(!cv) return;
  cleanup?.();
  const g=cv.getContext('2d')!, $=(id:string)=>document.getElementById(id) as HTMLInputElement, ids=['vol','tenor','thr','haz'];
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cur:Res|null=null, from:Res|null=null, to:Res|null=null, t0=0, raf=0, yMax=0, yFrom=0, yTo=0, prev:Res|null=null, pending=0;
  const nice=(v:number)=>{for(const n of [10,20,30,50,75,100,150,200,300,400]) if(v<=n) return n; return Math.ceil(v/100)*100;};
  const lerpArr=(a:number[],b:number[],k:number)=>b.map((v,i)=>(a[i]??v)+(v-(a[i]??v))*k);
  const mix=(a:Res,b:Res,k:number):Res=>({...b,T:a.T+(b.T-a.T)*k,H:isFinite(a.H)&&isFinite(b.H)?a.H+(b.H-a.H)*k:b.H,ee:lerpArr(a.ee,b.ee,k),pfe:lerpArr(a.pfe,b.pfe,k),samp:b.samp.map((r,i)=>lerpArr(a.samp[i],r,k))});
  function draw(r:Res,ym:number){
    const d=devicePixelRatio,w=cv.width=cv.clientWidth*d,h=cv.height=cv.clientHeight*d,L=44*d,Rp=12*d,Tp=10*d,B=22*d;
    const X=(yrs:number)=>L+(w-L-Rp)*yrs/TMAX, Y=(v:number)=>Tp+(h-Tp-B)*(1-(v+ym*0.5)/(ym*1.5)); // y from −ym/2 to ym
    const xi=(i:number)=>X(r.T*i/STEPS);
    g.clearRect(0,0,w,h); g.font=`${10*d}px ui-monospace,monospace`; g.lineWidth=d;
    for(const yr of [0,5,10,15,20,25,30]){g.strokeStyle='#1e293b';g.beginPath();g.moveTo(X(yr),Tp);g.lineTo(X(yr),h-B);g.stroke();g.fillStyle='#64748b';g.fillText(yr+'y',X(yr)-6*d,h-6*d);}
    for(const f of [-0.5,0,0.5,1]){const v=ym*f;g.strokeStyle=f===0?'#475569':'#1e293b';g.beginPath();g.moveTo(L,Y(v));g.lineTo(w-Rp,Y(v));g.stroke();g.fillStyle='#64748b';g.fillText(v.toFixed(0),6*d,Y(v)+3*d);}
    // default-weighted EE: EE(t)·hazard density, scaled for display — shows where CVA comes from
    const dens=r.ee.map((e,i)=>e*r.lam*Math.exp(-r.lam*r.T*i/STEPS)); const dm=Math.max(...dens,1e-9), sc=Math.min(1,(r.lam/0.1))*ym*0.35/dm;
    g.fillStyle='rgba(251,113,133,0.18)';g.beginPath();g.moveTo(xi(0),Y(0));dens.forEach((v,i)=>g.lineTo(xi(i),Y(v*sc)));g.lineTo(xi(STEPS),Y(0));g.closePath();g.fill();
    const line=(a:number[],c:string,lw:number)=>{g.strokeStyle=c;g.lineWidth=lw*d;g.beginPath();a.forEach((v,i)=>i?g.lineTo(xi(i),Y(Math.max(-ym*0.5,Math.min(ym,v)))):g.moveTo(xi(i),Y(v)));g.stroke();};
    r.samp.forEach(a=>line(a,'rgba(148,163,184,0.16)',1));
    if(isFinite(r.H)&&r.H<ym){g.setLineDash([6*d,5*d]);g.strokeStyle='#fcd34d';g.lineWidth=1.5*d;g.beginPath();g.moveTo(L,Y(r.H));g.lineTo(X(r.T),Y(r.H));g.stroke();g.setLineDash([]);g.fillStyle='#fcd34d';g.fillText('H',X(r.T)+4*d,Y(r.H)+3*d);}
    line(r.pfe,'#a78bfa',2.5); line(r.ee,'#38bdf8',2.5);
    g.strokeStyle='#475569';g.setLineDash([2*d,3*d]);g.beginPath();g.moveTo(X(r.T),Tp);g.lineTo(X(r.T),h-B);g.stroke();g.setLineDash([]);
  }
  const frame=(now:number)=>{const k=reduce?1:Math.min(1,(now-t0)/350),e=1-Math.pow(1-k,3);
    cur=mix(from!,to!,e); yMax=yFrom+(yTo-yFrom)*e; draw(cur,yMax); if(k<1) raf=requestAnimationFrame(frame);};
  const delta=(el:string,a:number,b:number,dp:number,pct=false)=>{const x=document.getElementById(el)!;const dv=b-a;if(Math.abs(dv)<Math.pow(10,-dp)/2){x.textContent='';return;}
    x.textContent=(dv>0?'▲ +':'▼ ')+(pct?(dv*100).toFixed(1)+' pts':dv.toFixed(dp));x.style.color=dv>0?'#f87171':'#4ade80';};
  function run(){
    pending=0;
    const vol=+$('vol').value/100,T=+$('tenor').value,thr=+$('thr').value,H=thr>=30?Infinity:thr/100*N,lam=+$('haz').value/100;
    ids.forEach(i=>document.getElementById(i+'-o')!.textContent=(i==='thr'&&thr>=30)?'none':$(i).value);
    const r=sim(vol,T,H,lam);
    const set=(id:string,v:string)=>{const e=document.getElementById(id)!;if(e.textContent!==v){e.textContent=v;e.classList.add('flash');setTimeout(()=>e.classList.remove('flash'),180);}};
    set('k-cva',r.cva.toFixed(3));set('k-ee',Math.max(...r.ee).toFixed(2));set('k-pfe',Math.max(...r.pfe).toFixed(2));set('k-pd',(r.pd*100).toFixed(1)+'%');
    if(prev){delta('d-cva',prev.cva,r.cva,3);delta('d-ee',Math.max(...prev.ee),Math.max(...r.ee),2);delta('d-pfe',Math.max(...prev.pfe),Math.max(...r.pfe),2);delta('d-pd',prev.pd,r.pd,1,true);}
    prev=r;
    const need=Math.max(...r.pfe,...r.samp.flat().map(Math.abs).sort((a,b)=>a-b).slice(-30,-29),5);
    from=cur??r; to=r; yFrom=yMax||nice(need); yTo=nice(need); t0=performance.now(); cancelAnimationFrame(raf); raf=requestAnimationFrame(frame);
  }
  const sched=()=>{ if(!pending) pending=requestAnimationFrame(run); };   // rAF-debounced: at most one sim per frame
  ids.forEach(i=>{$(i).addEventListener('input',sched);$(i).addEventListener('change',sched);});
  const onResize=()=>cur&&draw(cur,yMax); addEventListener('resize',onResize);
  cleanup=()=>{cancelAnimationFrame(raf);cancelAnimationFrame(pending);removeEventListener('resize',onResize);};
  run();
});
</script>
</Base>
