---
import Base from '../../layouts/Base.astro';
import raw from '../../content/mara-soluna.md?raw';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
const md = await createMarkdownProcessor();
const D = '/case-study/mara-soluna';
// Drop the title block (rendered in the hero); split the narrative into its "## " sections.
const body = raw.slice(raw.indexOf('\n## '));
const parts = body.split(/\n(?=## )/).map(s => s.trim()).filter(Boolean);
const slugify = (t) => t.toLowerCase().replace(/^\d+\.\s*/, '').replace(/\(.*?\)/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const navName = { 'summary':'Summary','thesis':'Thesis','company-overviews':'Company overviews','strategic-rationale-what-holds-and-what-doesn-t':'Strategic rationale','valuation':'Valuation','deal-structure-and-financing':'Deal structure','synergies':'Synergies','risks':'Risks','recommendation':'Recommendation','what-happened-next':'Hindsight','method-and-sources':'Sources' };
const figs = {
  'summary': [['02_answer','The answer: buy the project, not the company']],
  'company-overviews': [['04_soluna_overview','Soluna at a glance: sites, ownership and FY2023 results']],
  'valuation': [['06_capital_structure_ev','Market value and capital structure, March 28, 2024'],['07_trading_comps','Trading comparables (shown, not relied on)'],['10_dcf','DCF results: standalone, under MARA, Dorothy 2 only'],['12_valuation_summary','Valuation summary vs. the cost of the whole company']],
  'deal-structure-and-financing': [['13_whole_company_test','Tested and rejected: a tender for all of Soluna'],['14_recommended_structure','Recommended: all-cash purchase of Dorothy 2']],
  'synergies': [['15_synergies','Synergies: whole company vs. asset deal']],
  'recommendation': [['17_recommendation_hindsight','Recommendation and what happened next']],
};
const sections = await Promise.all(parts.map(async (s) => {
  const nl = s.indexOf('\n'); const title = s.slice(3, nl).trim(); const id = slugify(title);
  const html = (await md.render(s.slice(nl + 1).replace(/---\s*$/, '').trim())).code;
  return { id, title, nav: navName[id] ?? title, html, figs: figs[id] ?? [] };
}));
---
<Base title="MARA × Soluna M&A case study · Chafic Charafeddine">
<article class="max-w-6xl mx-auto px-6 py-16">
<a data-back href="/#case-study" class="text-sm text-gray-400 hover:text-accent">← Back to home</a>
<header class="mt-6 max-w-3xl">
<p class="text-accent text-sm">Independent M&A case study · Public information only · As of March 28, 2024 (FY2023 10-Ks)</p>
<h1 class="text-4xl sm:text-5xl font-bold mt-2 leading-tight">MARA × Soluna: buy the project, not the company</h1>
<p class="text-lg text-gray-300 mt-4 leading-relaxed reveal">Should MARA Holdings buy Soluna Holdings to own renewable-powered hosting capacity in Texas? Rebuilt from the FY2023 10-Ks, the answer is no: the value worth having is Soluna's 50 MW Dorothy 2 project, not the company.</p>
<div class="grid sm:grid-cols-3 gap-4 mt-8">
<div class="card p-5 reveal border-accent/40"><p class="text-xs uppercase tracking-widest text-accent">Recommendation</p><p class="text-white font-semibold mt-2">All-cash purchase of Dorothy 2 for up to $6.0M</p><p class="text-xs text-gray-400 mt-1">$4.0M at closing + $2.0M earn-out on energization</p></div>
<div class="card p-5 reveal"><p class="text-xs uppercase tracking-widest text-gray-400">Dorothy 2 NPV</p><p class="text-3xl font-bold text-emerald-400 mt-1">+$3.6M</p><p class="text-xs text-gray-400 mt-1">Worth $9.5M to MARA (range $5.6–15.0M)</p></div>
<div class="card p-5 reveal"><p class="text-xs uppercase tracking-widest text-gray-400">Whole company at $4.00/share</p><p class="text-3xl font-bold text-red-400 mt-1">–$20.3M</p><p class="text-xs text-gray-400 mt-1">$37.9M total cost vs. $17.6M of value</p></div>
</div>
<div class="flex flex-wrap gap-3 mt-8">
<a href={`${D}/MARA_Soluna_deck.pdf`} target="_blank" rel="noopener" class="px-4 py-2 rounded-full bg-accent text-ink font-semibold text-sm">Deck (PDF) ↓</a>
<a href={`${D}/MARA_Soluna_memo.pdf`} target="_blank" rel="noopener" class="px-4 py-2 rounded-full border border-white/20 hover:border-accent text-sm">Memo (PDF) ↓</a>
</div>
<p class="text-xs text-gray-500 mt-6">Not prepared for, or on behalf of, any employer, client, or either company. All figures in US$; "$M" means millions.</p>
</header>
<div class="lg:grid lg:grid-cols-[200px_1fr] lg:gap-12 mt-16">
<nav aria-label="Case study sections" class="hidden lg:block"><ul id="cs-nav" class="sticky top-24 space-y-1 text-sm border-l border-white/10">
{sections.map(s => <li><a href={`#${s.id}`} data-sec={s.id} class="block pl-4 -ml-px py-1 border-l-2 border-transparent text-gray-400 hover:text-white transition-colors">{s.nav}</a></li>)}
</ul></nav>
<div class="min-w-0 max-w-3xl">
{sections.map(s => (<section id={s.id} class="cs-sec pt-6 pb-10 border-b border-white/5 last:border-0">
<h2 class="text-2xl sm:text-3xl font-bold mb-4 reveal">{s.title}</h2>
<div class="cs-prose reveal" set:html={s.html}/>
{s.figs.map(([f, cap]) => (<figure class="card overflow-hidden mt-8 reveal"><a href={`${D}/${f}.1600.webp`} target="_blank" class="block"><img src={`${D}/${f}.1600.webp`} srcset={`${D}/${f}.800.webp 800w, ${D}/${f}.1600.webp 1600w`} sizes="(min-width:1024px) 768px, 100vw" width="1600" height="901" loading="lazy" decoding="async" alt={`Slide: ${cap}`} class="w-full"/></a><figcaption class="px-4 py-3 border-t border-white/10 text-xs text-gray-400">{cap}</figcaption></figure>))}
</section>))}
</div></div>
</article>
<script>
function csNav(){ const links=[...document.querySelectorAll<HTMLAnchorElement>('#cs-nav a')]; if(!links.length) return;
 const io=new IntersectionObserver(es=>{es.forEach(e=>{ if(e.isIntersecting){ links.forEach(l=>{const on=l.dataset.sec===e.target.id; l.classList.toggle('text-white',on); l.classList.toggle('border-accent',on); l.classList.toggle('text-gray-400',!on);}); } });},{rootMargin:'-30% 0px -60% 0px'});
 document.querySelectorAll('.cs-sec').forEach(s=>io.observe(s)); }
document.addEventListener('astro:page-load', csNav);
</script>
</Base>
